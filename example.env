# Keep authentication enabled by default. Set True only for local experiments.
IGNPRE_API_KEYS=False
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=
SQLITE_PATH=api_keys.db

# Upstream safeguards
UPSTREAM_TIMEOUT_SECONDS=45
UPSTREAM_MAX_RETRIES=1
UPSTREAM_RETRY_BACKOFF_SECONDS=0.5
MAX_CONCURRENT_UPSTREAM=8

# Optional fallback catalog; live Duck.ai model discovery is preferred.
DEFAULT_MODEL=gpt-5.6-luna
DUCKAI_MODELS=gpt-6-luna,gpt-5.6-luna,gpt-5.4-mini,claude-haiku-4-5,mistral-small-2603,tinfoil/gpt-oss-120b,tinfoil/gemma4-31b

# Comma-separated origins, or * for public API use (credentials are disabled).
CORS_ORIGINS=*
LOG_LEVEL=INFO
